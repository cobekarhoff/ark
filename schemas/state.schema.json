{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/state.schema.json",
  "title": "Run state.json",
  "type": "object",
  "required": ["schema", "run_id", "ticket", "playbook", "state", "status", "tier", "round", "next_action", "gates", "repos", "acs", "artifacts", "sessions", "lock", "ledger_seq", "ledger_head"],
  "properties": {
    "schema": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "ticket": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
    "playbook": { "type": "string", "minLength": 1 },
    "state": { "enum": ["intake", "awaiting_g0", "analyzed", "awaiting_g1", "approved", "building", "judging", "awaiting_ge", "awaiting_g2", "mrs_open", "done", "aborted"] },
    "status": { "enum": ["active", "waiting_human", "blocked", "done", "aborted"] },
    "tier": { "enum": ["T1", "T2", "T3", null], "description": "null until routing sets it" },
    "round": { "type": "integer", "minimum": 0 },
    "next_action": {
      "description": "Computed by the CLI; null when the run is closed",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "agent": { "type": "string" },
            "repo": { "type": "string" }
          }
        }
      ]
    },
    "gates": {
      "type": "object",
      "patternProperties": {
        "^G(0|1|2|E)$": {
          "type": "object",
          "required": ["answer", "by", "at", "packet_sha256"],
          "properties": {
            "answer": { "type": "string", "minLength": 1 },
            "by": { "type": "string", "minLength": 1 },
            "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
            "packet_sha256": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "order", "branch", "base_sha", "head_sha", "step"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "base_sha": { "type": "string", "minLength": 1 },
          "head_sha": { "type": ["string", "null"] },
          "step": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "acs": {
      "type": "object",
      "patternProperties": { "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "file"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "lock": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["session", "since"],
          "properties": {
            "session": { "type": "string", "minLength": 1 },
            "since": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "ledger_seq": { "type": "integer", "minimum": 0 },
    "ledger_head": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256 of the last ledger line (the anchor for edit/truncation detection)" }
  },
  "additionalProperties": false
}
