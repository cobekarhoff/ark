{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/ticket-frontmatter.schema.json",
  "title": "Local ticket frontmatter (parsed to JSON)",
  "type": "object",
  "required": ["id", "title", "status", "acceptance_criteria"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "milestone": { "type": "string" },
    "traces": { "type": "array", "items": { "type": "string" } },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" } },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$" },
          "text": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
