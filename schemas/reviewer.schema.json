{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/reviewer.schema.json",
  "title": "Reviewer agent output (reviewer-x, reviewer-s, security-reviewer)",
  "type": "object",
  "required": ["reviewer", "repo", "findings"],
  "properties": {
    "reviewer": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "confidence", "file", "line", "title", "evidence"],
        "properties": {
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
