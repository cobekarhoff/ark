{
  "type": "object",
  "properties": {
    "schema": {
      "const": "ticket.v1"
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "manifest_hash"
      ],
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "artifact",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "body": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "local",
            "jira"
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "acceptance_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "intent"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "ticket",
    "run",
    "attempt",
    "produced_by",
    "inputs",
    "body"
  ],
  "additionalProperties": false
}
