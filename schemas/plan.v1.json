{
  "type": "object",
  "properties": {
    "schema": {
      "const": "plan.v1"
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "manifest_hash"
      ],
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "artifact",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "body": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array"
        },
        "approach": {
          "type": "string"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "steps",
        "approach",
        "allowed_paths"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "ticket",
    "run",
    "attempt",
    "produced_by",
    "inputs",
    "body"
  ],
  "additionalProperties": false
}
