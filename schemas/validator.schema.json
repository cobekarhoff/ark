{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/validator.schema.json",
  "title": "Validator agent output",
  "type": "object",
  "required": [
    "repo",
    "head_sha",
    "verdicts"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "minLength": 1
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ac",
          "verdict"
        ],
        "properties": {
          "ac": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "red": {
            "type": "object",
            "required": [
              "sha",
              "outcome",
              "evidence"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "fail",
                  "error",
                  "pass"
                ],
                "description": "pass means the test asserts nothing; the verdict must then be fail"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "description": "Path to JUnit or log"
              }
            },
            "additionalProperties": false
          },
          "green": {
            "type": "object",
            "required": [
              "sha",
              "outcome",
              "evidence"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "flaky"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "description": "Path to JUnit or log"
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          },
          "manual": {
            "type": "object",
            "required": [
              "by",
              "at",
              "record"
            ],
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
              },
              "record": {
                "type": "string",
                "minLength": 1,
                "description": "Path to the signed human record"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "red",
                    "green"
                  ]
                },
                {
                  "required": [
                    "manual"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
