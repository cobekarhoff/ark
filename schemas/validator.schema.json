{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/validator.schema.json",
  "title": "Validator agent output",
  "type": "object",
  "required": ["repo", "head_sha", "verdicts"],
  "properties": {
    "repo": { "type": "string", "minLength": 1 },
    "head_sha": { "type": "string", "minLength": 1 },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac", "verdict", "red", "green"],
        "properties": {
          "ac": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$" },
          "verdict": { "enum": ["pass", "fail", "blocked"] },
          "red": {
            "type": "object",
            "required": ["sha", "outcome", "evidence"],
            "properties": {
              "sha": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["fail", "error"] },
              "evidence": { "type": "string", "minLength": 1, "description": "Path to JUnit or log" }
            },
            "additionalProperties": false
          },
          "green": {
            "type": "object",
            "required": ["sha", "outcome", "evidence"],
            "properties": {
              "sha": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["pass", "fail", "flaky"] },
              "evidence": { "type": "string", "minLength": 1, "description": "Path to JUnit or log" }
            },
            "additionalProperties": false
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
