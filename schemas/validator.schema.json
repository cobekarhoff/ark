{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/validator.schema.json",
  "title": "Validator agent output",
  "type": "object",
  "required": [
    "repo",
    "head_sha",
    "verdicts",
    "test_audit"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "minLength": 1
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ac",
          "verdict"
        ],
        "properties": {
          "ac": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "red": {
            "type": "object",
            "required": [
              "sha",
              "outcome",
              "evidence"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "fail",
                  "error",
                  "pass"
                ],
                "description": "For a new AC, pass means the test asserts nothing and the verdict must then be fail. For a preserved AC (preservation proof), pass on the base is the expected outcome."
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "description": "Path to JUnit or log"
              }
            },
            "additionalProperties": false
          },
          "green": {
            "type": "object",
            "required": [
              "sha",
              "outcome",
              "evidence"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "flaky"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "description": "Path to JUnit or log"
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          },
          "manual": {
            "type": "object",
            "required": [
              "by",
              "at",
              "record"
            ],
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
              },
              "record": {
                "type": "string",
                "minLength": 1,
                "description": "Path to the signed human record"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "red",
                    "green"
                  ]
                },
                {
                  "required": [
                    "manual"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "test_audit": {
      "type": "array",
      "description": "Last validator step (ARK-108-AC7): one entry per AC-tagged test, audited against rules/test-audit.md",
      "items": {
        "type": "object",
        "required": [
          "test",
          "ac",
          "verdict",
          "asserts_ac_behavior",
          "mock_supplies_assertion",
          "expected_from_subject"
        ],
        "properties": {
          "test": {
            "type": "string",
            "minLength": 1,
            "description": "file > describe > test name"
          },
          "ac": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "asserts_ac_behavior": {
            "type": "boolean",
            "description": "The test asserts the behavior its AC names"
          },
          "mock_supplies_assertion": {
            "type": "boolean",
            "description": "A mock supplies the behavior the test asserts"
          },
          "expected_from_subject": {
            "type": "boolean",
            "description": "An expected value is generated by the code under test"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "properties": {
                "asserts_ac_behavior": {
                  "const": true
                },
                "mock_supplies_assertion": {
                  "const": false
                },
                "expected_from_subject": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
