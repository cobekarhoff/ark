{
  "type": "object",
  "properties": {
    "schema": {
      "const": "acceptance.v1"
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "manifest_hash"
      ],
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "artifact",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "body": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "repo": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1
              },
              "environment_class": {
                "enum": [
                  "local-emulator",
                  "ephemeral"
                ]
              },
              "rejection_style": {
                "type": "boolean"
              },
              "positive_control": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "repo",
              "command",
              "timeout_s",
              "environment_class",
              "rejection_style",
              "limitations"
            ],
            "additionalProperties": true
          }
        },
        "locked_roots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string"
              },
              "root": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)(?!.*/$).+$"
              }
            },
            "required": [
              "repo",
              "root"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "checks",
        "locked_roots"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "ticket",
    "run",
    "attempt",
    "produced_by",
    "inputs",
    "body"
  ],
  "additionalProperties": false
}
