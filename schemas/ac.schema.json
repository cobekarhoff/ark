{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/ac.schema.json",
  "title": "ac.yml entries (parsed to JSON)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "text", "restatement", "level", "repos", "risk_tags"],
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$" },
      "text": { "type": "string", "minLength": 1, "description": "Ticket text, verbatim" },
      "restatement": { "type": "string", "minLength": 1, "description": "Testable restatement" },
      "level": { "enum": ["e2e", "integration", "manual", "unit"] },
      "repos": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
      "risk_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "additionalProperties": false
  }
}
