{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/implementer.schema.json",
  "title": "Implementer agent output",
  "type": "object",
  "required": ["repo", "branch", "head_sha", "ac_addressed", "status"],
  "properties": {
    "repo": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "head_sha": { "type": "string", "minLength": 1 },
    "commits": { "type": "array", "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" } },
    "ac_addressed": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$" } },
    "status": { "enum": ["done", "blocked"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
