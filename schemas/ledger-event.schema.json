{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/ledger-event.schema.json",
  "title": "One line of ledger.ndjson",
  "type": "object",
  "required": ["seq", "ts", "type", "data"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "type": { "type": "string", "minLength": 1 },
    "data": { "type": "object" },
    "prev": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Hash of the previous event line" }
  },
  "additionalProperties": false
}
