{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobekarhoff/ark/schemas/ticket.schema.json",
  "title": "Normalized ticket.json",
  "type": "object",
  "required": ["id", "title", "source", "acceptance_criteria", "body"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "enum": ["local", "jira", "github", "gitlab"] },
    "url": { "type": "string" },
    "status": { "type": "string" },
    "milestone": { "type": "string" },
    "traces": { "type": "array", "items": { "type": "string" } },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" } },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+-AC[0-9]+$" },
          "text": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "body": { "type": "string" }
  },
  "additionalProperties": false
}
