{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "noResolve": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "files": [
    "src/core/hash.ts", "src/core/ids.ts", "src/core/contracts.ts", "src/core/pipeline.ts",
    "src/core/effects.ts", "src/core/events.ts", "src/core/state.ts", "src/core/world.ts",
    "src/core/decide.ts"
  ]
}
