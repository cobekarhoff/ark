#!/usr/bin/env bun
// Fake `glab`: records each call, keeps open MRs in the fake host state, and answers the calls `ark merge-request open` makes.
// The blocks call fails when FAKE_GLAB_BLOCK_FAIL is set.
import { creates, editAfterFirstProbe, option, owner, raceAfterFirstProbe, readState, record, repo, writeState } from "./fake-host.ts";

const argv = process.argv.slice(2);
const body = option(argv, "--description");
const previous = creates();
record("glab", argv, body);
const state = readState();

if (argv[0] === "mr" && argv[1] === "create") {
  const url = `https://gitlab.com/org/${repo}/-/merge_requests/${previous + 1}`;
  writeState([...state, { number: previous + 1, url, head: option(argv, "--source-branch"), repo, body: body! }]);
  console.log(url);
} else if (argv[0] === "mr" && argv[1] === "update") {
  writeState(state.map((mr) => (mr.number === Number(argv[2]) && mr.repo === repo ? { ...mr, body: body! } : mr)));
} else if (argv[0] === "mr" && argv[1] === "view") {
  console.log(JSON.stringify({ state: "opened" }));
} else if (argv[0] === "api") {
  const path = argv.at(-1)!;
  if (path === "user") {
    console.log(JSON.stringify({ username: owner }));
  } else if (path.includes("/blocks")) {
    if (process.env.FAKE_GLAB_BLOCK_FAIL) {
      console.error("403 Forbidden: merge request dependencies need a paid tier");
      process.exit(1);
    }
    console.log("{}");
  } else if (path.includes("source_branch=")) {
    if (process.env.FAKE_PROBE_FAIL) {
      console.error("502 Bad Gateway");
      process.exit(1);
    }
    if (raceAfterFirstProbe("source_branch=", state)) {
      console.log("[]");
      process.exit(0);
    }
    const head = decodeURIComponent(path.match(/source_branch=([^&]+)/)![1]);
    editAfterFirstProbe("source_branch=", state);
    console.log(
      JSON.stringify(state.filter((mr) => mr.repo === repo && mr.head === head).map((mr) => ({ iid: mr.number, web_url: mr.url, description: mr.body }))),
    );
  } else {
    const iid = Number(path.match(/merge_requests\/(\d+)/)![1]);
    console.log(JSON.stringify({ id: 9000 + iid, iid }));
  }
}
