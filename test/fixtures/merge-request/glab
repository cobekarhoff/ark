#!/usr/bin/env bun
// Fake `glab`: records each call, keeps open MRs in the fake host state, and answers the calls `ark merge-request open` makes.
// The blocks call fails when FAKE_GLAB_BLOCK_FAIL is set. An upload answers a url made from the bytes of the file it reads;
// FAKE_GLAB_UPLOAD_FAIL=<n> fails the n-th upload.
import { createHash } from "node:crypto";
import { existsSync, readFileSync } from "node:fs";
import { creates, logged, editAfterFirstProbe, nextNumber, option, owner, raceAfterFirstProbe, readState, record, repo, writeState } from "./fake-host.ts";

const argv = process.argv.slice(2);
const body = option(argv, "--description");
const previous = creates();
const number = argv[0] === "mr" && argv[1] === "create" ? nextNumber(previous) : 0;
record("glab", argv, body);
const state = readState();

if (argv[0] === "mr" && argv[1] === "create") {
  const url = `https://gitlab.com/org/${repo}/-/merge_requests/${number}`;
  writeState([...state, { number, url, head: option(argv, "--source-branch"), repo, body: body! }]);
  console.log(url);
} else if (argv[0] === "mr" && argv[1] === "update") {
  writeState(state.map((mr) => (mr.number === Number(argv[2]) && mr.repo === repo ? { ...mr, body: body! } : mr)));
} else if (argv[0] === "mr" && argv[1] === "view") {
  console.log(JSON.stringify({ state: "opened" }));
} else if (argv.includes("projects/:fullpath/uploads")) {
  const file = argv[argv.indexOf("-F") + 1].replace(/^file=@/, "");
  if (Number(process.env.FAKE_GLAB_UPLOAD_FAIL) === logged("projects/:fullpath/uploads") || !existsSync(file)) {
    console.error("400 Bad Request: file is invalid");
    process.exit(1);
  }
  const sha = createHash("sha256").update(readFileSync(file)).digest("hex").slice(0, 12);
  console.log(JSON.stringify({ url: `/uploads/${sha}/${file.split("/").at(-1)}` }));
} else if (argv[0] === "api") {
  const path = argv.at(-1)!;
  if (path === "user") {
    console.log(JSON.stringify({ username: owner }));
  } else if (path.includes("/blocks")) {
    if (process.env.FAKE_GLAB_BLOCK_FAIL) {
      console.error("403 Forbidden: merge request dependencies need a paid tier");
      process.exit(1);
    }
    console.log("{}");
  } else if (path.includes("source_branch=")) {
    if (process.env.FAKE_PROBE_FAIL) {
      console.error("502 Bad Gateway");
      process.exit(1);
    }
    if (raceAfterFirstProbe("source_branch=", state)) {
      console.log("[]");
      process.exit(0);
    }
    const head = decodeURIComponent(path.match(/source_branch=([^&]+)/)![1]);
    editAfterFirstProbe("source_branch=", state);
    console.log(
      JSON.stringify(state.filter((mr) => mr.repo === repo && mr.head === head).map((mr) => ({ iid: mr.number, web_url: mr.url, description: mr.body }))),
    );
  } else {
    const iid = Number(path.match(/merge_requests\/(\d+)/)![1]);
    console.log(JSON.stringify({ id: 9000 + iid, iid }));
  }
}
