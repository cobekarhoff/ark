#!/usr/bin/env bun
// Fake `gh`: records each call, keeps open PRs in the fake host state, and answers the calls `ark merge-request open` makes.
// `gh repo view --json visibility` answers {"visibility":"<FAKE_GH_VISIBILITY>"} (default PUBLIC, the visibility of ark's own repo);
// FAKE_GH_VISIBILITY=<fail> fails as gh 2.103.3 did with a bad token, and <empty> answers nothing.
import { readFileSync } from "node:fs";
import { creates, editAfterFirstProbe, nextNumber, option, owner, raceAfterFirstProbe, readState, record, repo, writeState } from "./fake-host.ts";

const argv = process.argv.slice(2);
const bodyFile = option(argv, "--body-file");
const body = bodyFile ? readFileSync(bodyFile, "utf8") : undefined;
const previous = creates();
const number = argv[0] === "pr" && argv[1] === "create" ? nextNumber(previous) : 0;
record("gh", argv, body);
const state = readState();

if (argv.includes("--help")) {
  // `gh pr create --help` lists --attach from gh 2.99.0; FAKE_GH_NO_ATTACH makes this an older gh.
  console.log(`Usage: gh pr ${argv[1]} [flags]\n\nFlags:\n  --body-file file\n${process.env.FAKE_GH_NO_ATTACH ? "" : "  --attach strings   Attach local images or videos\n"}`);
} else if (argv[0] === "api" && argv[1] === "user") {
  console.log(owner);
} else if (argv[0] === "repo" && argv[1] === "view" && option(argv, "--json") === "visibility") {
  const visibility = process.env.FAKE_GH_VISIBILITY ?? "PUBLIC";
  if (visibility === "<fail>") {
    console.error("HTTP 401: Bad credentials (https://api.github.com/graphql)");
    process.exit(1);
  }
  if (visibility !== "<empty>") console.log(JSON.stringify({ visibility }));
} else if (argv[0] === "pr" && argv[1] === "list") {
  if (process.env.FAKE_PROBE_FAIL) {
    console.error("HTTP 502: bad gateway");
    process.exit(1);
  }
  const head = option(argv, "--head");
  if (raceAfterFirstProbe('"list"', state)) {
    console.log("[]");
    process.exit(0);
  }
  editAfterFirstProbe('"list"', state);
  console.log(
    JSON.stringify(state.filter((pr) => pr.repo === repo && pr.head === head).map(({ number, url, body }) => ({ number, url, body }))),
  );
} else if (argv[0] === "pr" && argv[1] === "create") {
  const url = `https://github.com/org/${repo}/pull/${number}`;
  writeState([...state, { number, url, head: option(argv, "--head"), repo, body: body! }]);
  console.log(url);
} else if (argv[0] === "pr" && argv[1] === "edit") {
  writeState(state.map((pr) => (pr.number === Number(argv[2]) && pr.repo === repo ? { ...pr, body: body! } : pr)));
} else if (argv[0] === "pr" && argv[1] === "view") {
  console.log(JSON.stringify({ state: "OPEN", statusCheckRollup: [] }));
}
