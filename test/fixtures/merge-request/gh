#!/usr/bin/env bun
// Fake `gh`: records each call, keeps open PRs in the fake host state, and answers the calls `ark merge-request open` makes.
import { readFileSync } from "node:fs";
import { creates, option, owner, readState, record, repo, writeState } from "./fake-host.ts";

const argv = process.argv.slice(2);
const bodyFile = option(argv, "--body-file");
const body = bodyFile ? readFileSync(bodyFile, "utf8") : undefined;
const previous = creates();
record("gh", argv, body);
const state = readState();

if (argv[0] === "api" && argv[1] === "user") {
  console.log(owner);
} else if (argv[0] === "pr" && argv[1] === "list") {
  if (process.env.FAKE_PROBE_FAIL) {
    console.error("HTTP 502: bad gateway");
    process.exit(1);
  }
  const head = option(argv, "--head");
  console.log(
    JSON.stringify(state.filter((pr) => pr.repo === repo && pr.head === head).map(({ number, url, body }) => ({ number, url, body }))),
  );
} else if (argv[0] === "pr" && argv[1] === "create") {
  const url = `https://github.com/org/${repo}/pull/${previous + 1}`;
  writeState([...state, { number: previous + 1, url, head: option(argv, "--head"), repo, body: body! }]);
  console.log(url);
} else if (argv[0] === "pr" && argv[1] === "edit") {
  writeState(state.map((pr) => (pr.number === Number(argv[2]) && pr.repo === repo ? { ...pr, body: body! } : pr)));
} else if (argv[0] === "pr" && argv[1] === "view") {
  console.log(JSON.stringify({ state: "OPEN", statusCheckRollup: [] }));
}
