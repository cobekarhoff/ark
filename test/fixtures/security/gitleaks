#!/usr/bin/env bun
// Fake `gitleaks git`: scans `git log -p <--log-opts>` of its working directory for added `FAKE-SECRET <rule>` lines and writes
// them to --report-path as gitleaks does. Without --redact the report holds a sentinel as `Secret`, and every finding is also
// printed to stderr with its Secret, as the real gitleaks logs it. Exit 1 on a leak, 0 when clean. As the real gitleaks does,
// it skips a line with `gitleaks:allow` unless --ignore-gitleaks-allow is given, a file that `paths = ["<file>"]` of the
// --config file (else `.gitleaks.toml` of the working directory) allowlists, and a fingerprint listed in the
// `.gitleaksignore` of --gitleaks-ignore-path (default: the working directory). It runs `git log -p` in the working directory, so a
// `-diff` or `binary` attribute of the `.gitattributes` there hides a file's lines, and `--text` shows them again, as for the real tool.
// Overrides: FAKE_GITLEAKS_EXIT (exit with it, write no report), FAKE_GITLEAKS_STDERR, FAKE_GITLEAKS_REPORT (raw report text).
import { appendFileSync, existsSync, readFileSync, statSync, writeFileSync } from "node:fs";

const argv = process.argv.slice(2);
if (process.env.FAKE_SCAN_LOG) appendFileSync(process.env.FAKE_SCAN_LOG, `gitleaks ${argv.join(" ")}\n`);

const value = (name) => {
  const inline = argv.find((arg) => arg.startsWith(`${name}=`));
  if (inline !== undefined) return inline.slice(name.length + 1);
  const at = argv.indexOf(name);
  return at < 0 ? undefined : argv[at + 1];
};
const reportPath = value("--report-path");
const redacted = argv.includes("--redact");
const ignoreAllow = argv.includes("--ignore-gitleaks-allow");
const configPath = value("--config") ?? ".gitleaks.toml";
const pathsLine = existsSync(configPath) ? /^\s*paths\s*=\s*\[(.*)\]/m.exec(readFileSync(configPath, "utf8")) : null;
const allowedPaths = [...(pathsLine?.[1] ?? "").matchAll(/"([^"]+)"/g)].map((match) => match[1]);
const ignoreBase = value("--gitleaks-ignore-path") ?? ".";
const ignoreFile = statSync(ignoreBase).isDirectory() ? `${ignoreBase}/.gitleaksignore` : ignoreBase;
const ignored = existsSync(ignoreFile) ? readFileSync(ignoreFile, "utf8").split("\n") : [];

if (process.env.FAKE_GITLEAKS_EXIT !== undefined) {
  if (process.env.FAKE_GITLEAKS_STDERR) console.error(process.env.FAKE_GITLEAKS_STDERR);
  process.exit(Number(process.env.FAKE_GITLEAKS_EXIT));
}

const range = (value("--log-opts") ?? "").split(/\s+/).filter(Boolean);
const log = Bun.spawnSync(["git", "log", "-p", "--format=COMMIT:%H", ...range], { stdout: "pipe", stderr: "pipe" });
if (log.exitCode !== 0) {
  console.error(`ERR git log failed: ${log.stderr.toString()}`);
  process.exit(2);
}

const leaks = [];
let commit = "";
let file = "";
let line = 0;
for (const text of log.stdout.toString().split("\n")) {
  if (text.startsWith("COMMIT:")) commit = text.slice(7);
  else if (text.startsWith("+++ b/")) file = text.slice(6);
  else if (text.startsWith("@@ ")) line = Number(/\+(\d+)/.exec(text)[1]) - 1;
  else if (text.startsWith("+") && !text.startsWith("+++")) {
    line += 1;
    const rule = /^\+FAKE-SECRET (\S+)/.exec(text)?.[1];
    const allowed =
      (!ignoreAllow && text.includes("gitleaks:allow")) ||
      allowedPaths.includes(file) ||
      ignored.includes(`${commit}:${file}:${rule}:${line}`);
    if (rule !== undefined && !allowed)
      leaks.push({
        RuleID: rule,
        File: file,
        StartLine: line,
        Commit: commit,
        Fingerprint: `${commit}:${file}:${rule}:${line}`,
        Secret: redacted ? "REDACTED" : "SENTINEL-SECRET-VALUE-4242",
      });
  } else if (text.startsWith(" ")) line += 1;
}

if (process.env.FAKE_GITLEAKS_STDERR) console.error(process.env.FAKE_GITLEAKS_STDERR);
for (const leak of leaks) console.error(`Finding: ${leak.RuleID} Secret: ${leak.Secret} File: ${leak.File}`);
if (reportPath !== undefined)
  writeFileSync(reportPath, process.env.FAKE_GITLEAKS_REPORT ?? JSON.stringify(leaks));
process.exit(leaks.length > 0 ? 1 : 0);
